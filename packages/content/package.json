{
  "name": "@italia/content",
  "version": "0.0.0",
  "private": true,
  "description": "Build-time content pipeline for the Italia seed (lemmas, sentences, grammar graph) and the seed's zod schema.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node.ts",
    "./seed.v1.json": "./seed/seed.v1.json",
    "./stories.v1.json": "./seed/stories.v1.json"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "fetch:sources": "NODE_USE_ENV_PROXY=1 tsx scripts/fetch-sources.ts",
    "build:seed": "NODE_USE_ENV_PROXY=1 NODE_OPTIONS=--max-old-space-size=8192 tsx scripts/build-seed.ts",
    "build:stories": "tsx scripts/build-stories.ts",
    "lint": "eslint --max-warnings 0 .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  }
}
