      "title": {
        "it": "Ritorno al mare",
        "en": "Back to the sea"
      },
      "band": 1500,
      "blurb": "Piero takes the train back to his seaside village after a lifetime away, with his son, his grandson and Elena, to find his old friend Franco."
    },
    {
      "id": "il-colloquio",
      "title": {
        "it": "Il colloquio",
        "en": "The job interview"
      },
      "band": 2000,
      "blurb": "Alessandro is nearly thirty and bored of selling holidays he never takes, so he applies to an ice-cream company: an application, a phone call, two interviews and a nerve-racking first week."
    },
    {
      "id": "il-libro-scomparso",
      "title": {
        "it": "Il libro scomparso",
        "en": "The missing book"
      },
      "band": 2000,
      "blurb": "On Sara's first week at a small publisher, the only copy of a secret new novel vanishes from the boss's desk, and she is the obvious suspect."
    },
    {
      "id": "il-podcast-di-giulia",
      "title": {
        "it": "Il podcast di Giulia",
        "en": "Giulia's podcast"
      },
      "band": 2000,
      "blurb": "Giulia, thirty, records a weekly show from her bedroom about everyday life in Italy: phones, living with your parents, coffee, city versus countryside and cheap travel, with strong opinions and listeners' questions."
    },
    {
      "id": "storie-d-italia",
      "title": {
        "it": "Storie d'Italia",
        "en": "Stories of Italy"
      },
      "band": 2000,
      "blurb": "In her history lessons, the teacher Ms Ferri tells her class how Italy was made: Roman roads, Dante's language, Leonardo in Milan, the Unification and the great emigration."
    },
    {
      "id": "dietro-il-muro",
      "title": {
        "it": "Dietro il muro",
        "en": "Behind the wall"
      },
      "band": 3000,
      "blurb": "Building work at Gino's bar uncovers a metal box hidden in a wall for sixty years, and the whole of Via Verdi sets out to deliver a letter that never arrived."
    },
    {
      "id": "fatti-e-opinioni",
      "title": {
        "it": "Fatti e opinioni",
        "en": "Facts and opinions"
      },
      "band": 3000,
      "blurb": "Five short magazine articles on debates that divide Italy today, each giving both sides: crowds in Venice, remote work and the return to the villages, local languages, slow food against fast food, and young people leaving for abroad."
    },
    {
