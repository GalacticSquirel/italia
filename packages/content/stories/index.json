      "title": {
        "it": "L'uomo di via Verdi",
        "en": "The man on Via Verdi"
      },
      "band": 150,
      "blurb": "Luca has just moved to Via Verdi, and every day a stranger stands in the street and watches his house."
    },
    {
      "id": "il-segreto-di-tommaso",
      "title": {
        "it": "Il segreto di Tommaso",
        "en": "Tommaso's secret"
      },
      "band": 300,
      "blurb": "Money keeps vanishing from Sara's family home, and her little brother Tommaso is acting very strangely."
    },
    {
      "id": "il-telefono-di-marco",
      "title": {
        "it": "Il telefono di Marco",
        "en": "Marco's phone"
      },
      "band": 500,
      "blurb": "Luca's sister Anna finds a phone in the street, and the messages that keep arriving sound like a secret plan."
    },
    {
      "id": "la-signora-delle-dieci",
      "title": {
        "it": "La signora delle dieci",
        "en": "The ten o'clock lady"
      },
      "band": 750,
      "blurb": "Every morning at ten a quiet lady sits in Gino's bar and writes in a little book, and Piero cannot stop wondering what she writes."
    },
    {
      "id": "la-storia-di-piero",
      "title": {
        "it": "La storia di Piero",
        "en": "Piero's story"
      },
      "band": 1000,
      "blurb": "Over coffee at Gino's bar, Piero tells Elena the story of his life: a village by the sea, a red dress, a long silence."
    },
    {
      "id": "ritorno-al-mare",
      "title": {
        "it": "Ritorno al mare",
        "en": "Back to the sea"
      },
      "band": 1500,
      "blurb": "Piero takes the train back to his seaside village after a lifetime away, with his son, his grandson and Elena, to find his old friend Franco."
    },
    {
      "id": "il-libro-scomparso",
      "title": {
        "it": "Il libro scomparso",
        "en": "The missing book"
      },
      "band": 2000,
      "blurb": "On Sara's first week at a small publisher, the only copy of a secret new novel vanishes from the boss's desk, and she is the obvious suspect."
    },
    {
      "id": "dietro-il-muro",
      "title": {
        "it": "Dietro il muro",
        "en": "Behind the wall"
      },
      "band": 3000,
      "blurb": "Building work at Gino's bar uncovers a metal box hidden in a wall for sixty years, and the whole of Via Verdi sets out to deliver a letter that never arrived."
    }
  ],
