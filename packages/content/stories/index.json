      "title": {
        "it": "Città d'Italia",
        "en": "Cities of Italy"
      },
      "band": 1500,
      "blurb": "Irene and Pietro spend two weeks crossing Italy by train: Rome, Naples, Venice, Florence and Palermo, five real cities compared through history, art and food."
    },
