            {"text":"resto","start":47,"end":52,"lemmaId":36140076},
            {"text":"sveglio","start":53,"end":60,"lemmaId":2079063429}
          ],
          "grammarIds": [1,7,11,12,17,24]
        },
        {
          "it": "«Capisco. Che lavoro fa?»",
