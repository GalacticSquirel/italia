            {"text":"giorno","start":59,"end":65,"lemmaId":1778842393}
          ],
          "grammarIds": [1,3,13,16,17]
        },
        {
          "it": "«E quanti caffè beve?»",
          "en": "\"And how many coffees do you drink?\"",
