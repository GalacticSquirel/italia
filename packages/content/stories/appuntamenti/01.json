          "tokens": [
            {"text":"Lei","start":0,"end":3,"lemmaId":492290760},
            {"text":"non","start":4,"end":7,"lemmaId":310745945},
            {"text":"è","start":8,"end":9,"lemmaId":1898857869},
            {"text":"malato","start":10,"end":16,"lemmaId":1713467308},
