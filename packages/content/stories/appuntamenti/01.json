            {"text":"succede","start":17,"end":24,"lemmaId":881484969}
          ],
          "grammarIds": [1,12]
        },
        {
          "it": "«Buongiorno, dottore. Sono sempre stanco, e da una settimana mi fa male la testa.",
          "en": "\"Good morning, doctor. I'm always tired, and for a week I've been getting headaches.",
          "tokens": [
            {"text":"Buongiorno","start":1,"end":11,"lemmaId":1890158688},
            {"text":"dottore","start":13,"end":20,"lemmaId":1738940512},
            {"text":"Sono","start":22,"end":26,"lemmaId":1898857869},
            {"text":"sempre","start":27,"end":33,"lemmaId":1595547516},
            {"text":"stanco","start":34,"end":40,"lemmaId":804817346},
            {"text":"e","start":42,"end":43,"lemmaId":1646006819},
            {"text":"da","start":44,"end":46,"lemmaId":663456737},
            {"text":"una","start":47,"end":50,"lemmaId":736601827},
            {"text":"settimana","start":51,"end":60,"lemmaId":99576433},
            {"text":"mi","start":61,"end":63,"lemmaId":277405578},
            {"text":"fa","start":64,"end":66,"lemmaId":1788811798},
            {"text":"male","start":67,"end":71,"lemmaId":1024307748},
            {"text":"la","start":72,"end":74,"lemmaId":572321737},
            {"text":"testa","start":75,"end":80,"lemmaId":1385561472}
          ],
          "grammarIds": [1,2,3,5,13,15,16]
        },
        {
          "it": "E mi fanno male anche le spalle.»",
          "en": "And my shoulders hurt too.\"",
          "tokens": [
            {"text":"E","start":0,"end":1,"lemmaId":1646006819},
            {"text":"mi","start":2,"end":4,"lemmaId":277405578},
            {"text":"fanno","start":5,"end":10,"lemmaId":1788811798},
            {"text":"male","start":11,"end":15,"lemmaId":1024307748},
            {"text":"anche","start":16,"end":21,"lemmaId":1558928757},
            {"text":"le","start":22,"end":24,"lemmaId":572321737},
            {"text":"spalle","start":25,"end":31,"lemmaId":1388700336}
          ],
          "grammarIds": [1,2,13]
        },
        {
          "it": "«Dorme bene?»",
          "en": "\"Are you sleeping well?\"",
          "tokens": [
            {"text":"Dorme","start":1,"end":6,"lemmaId":1886257394},
            {"text":"bene","start":7,"end":11,"lemmaId":2005558240}
          ],
          "grammarIds": [12]
        },
        {
          "it": "«No, dormo poco. Mi sveglio alle quattro e poi resto sveglio.»",
          "en": "\"No, I'm not sleeping much. I wake up at four and then I stay awake.\"",
          "tokens": [
            {"text":"No","start":1,"end":3,"lemmaId":1018956403},
            {"text":"dormo","start":5,"end":10,"lemmaId":1886257394},
            {"text":"poco","start":11,"end":15,"lemmaId":511276779},
            {"text":"Mi","start":17,"end":19,"lemmaId":277405578},
