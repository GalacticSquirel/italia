            {"text":"può","start":34,"end":37,"lemmaId":1082530027},
            {"text":"sedersi","start":38,"end":45,"lemmaId":454339348,"partIds":[813176480]},
            {"text":"qui","start":46,"end":49,"lemmaId":1744058167}
          ],
          "grammarIds": [1,11,14,24]
        },
        {
          "it": "Allora, che cosa succede?»",
          "en": "So, what seems to be the matter?\"",
          "tokens": [
            {"text":"Allora","start":0,"end":6,"lemmaId":1636569757},
            {"text":"che","start":8,"end":11,"lemmaId":1536807558},
