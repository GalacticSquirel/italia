            {"text":"lavoro","start":14,"end":20,"lemmaId":1886762730},
            {"text":"fa","start":21,"end":23,"lemmaId":1788811798}
          ],
          "grammarIds": [1,12,13]
        },
        {
          "it": "«Lavoro in un ufficio. Sto seduto al computer dieci ore al giorno.»",
          "en": "\"I work in an office. I sit at the computer ten hours a day.\"",
          "tokens": [
            {"text":"Lavoro","start":1,"end":7,"lemmaId":1886762730},
            {"text":"in","start":8,"end":10,"lemmaId":396614201},
            {"text":"un","start":11,"end":13,"lemmaId":736601827},
            {"text":"ufficio","start":14,"end":21,"lemmaId":1264533692},
            {"text":"Sto","start":23,"end":26,"lemmaId":316316277},
            {"text":"seduto","start":27,"end":33,"lemmaId":454339348},
            {"text":"al","start":34,"end":36,"lemmaId":714887343,"partIds":[572321737]},
            {"text":"computer","start":37,"end":45,"lemmaId":2102201660},
            {"text":"dieci","start":46,"end":51,"lemmaId":1543202801},
            {"text":"ore","start":52,"end":55,"lemmaId":1060647549},
