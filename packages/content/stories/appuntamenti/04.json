            {"text":"troppo","start":25,"end":31,"lemmaId":1275340524}
          ],
          "grammarIds": [9,29]
        },
        {
          "it": "«Lei deve fidarsi di me. Faccio questo lavoro da una vita.»",
          "en": "\"You have to trust me. I've been doing this job all my life.\"",
          "tokens": [
