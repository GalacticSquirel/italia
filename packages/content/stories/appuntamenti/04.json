            {"text":"guarda","start":20,"end":26,"lemmaId":550261201},
            {"text":"bene","start":27,"end":31,"lemmaId":2005558240}
          ],
          "grammarIds": [1,11,17,24]
        },
        {
          "it": "Non ha mai avuto così pochi capelli, ma gli stanno bene. Davvero bene.",
