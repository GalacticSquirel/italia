          "tokens": [
            {"text":"Non","start":1,"end":4,"lemmaId":310745945},
            {"text":"troppo","start":5,"end":11,"lemmaId":1275340524},
            {"text":"ripete","start":14,"end":20,"lemmaId":1229040806},
            {"text":"Enzo","start":21,"end":25,"lemmaId":null,"isName":true},
            {"text":"e","start":27,"end":28,"lemmaId":1646006819},
            {"text":"comincia","start":29,"end":37,"lemmaId":1835837434},
            {"text":"a","start":38,"end":39,"lemmaId":714887343},
            {"text":"tagliare","start":40,"end":48,"lemmaId":394170735}
          ],
          "grammarIds": [9,11,12,16]
        },
        {
          "it": "«Lei non è di qui, vero? Si sente da come parla.»",
          "en": "\"You're not from round here, are you? I can hear it in the way you talk.\"",
          "tokens": [
            {"text":"Lei","start":1,"end":4,"lemmaId":492290760},
            {"text":"non","start":5,"end":8,"lemmaId":310745945},
            {"text":"è","start":9,"end":10,"lemmaId":1898857869},
            {"text":"di","start":11,"end":13,"lemmaId":1629507913},
            {"text":"qui","start":14,"end":17,"lemmaId":1744058167},
            {"text":"vero","start":19,"end":23,"lemmaId":19837506},
            {"text":"Si","start":25,"end":27,"lemmaId":813176480},
            {"text":"sente","start":28,"end":33,"lemmaId":692972340},
            {"text":"da","start":34,"end":36,"lemmaId":663456737},
            {"text":"come","start":37,"end":41,"lemmaId":136575964},
            {"text":"parla","start":42,"end":47,"lemmaId":146687855}
          ],
          "grammarIds": [4,5,9,10,11,12,16,24]
        },
        {
          "it": "«No, sono a Torino da poco.»",
          "en": "\"No, I haven't been in Turin long.\"",
          "tokens": [
            {"text":"No","start":1,"end":3,"lemmaId":1018956403},
            {"text":"sono","start":5,"end":9,"lemmaId":1898857869},
            {"text":"a","start":10,"end":11,"lemmaId":714887343},
            {"text":"Torino","start":12,"end":18,"lemmaId":null,"isName":true},
            {"text":"da","start":19,"end":21,"lemmaId":663456737},
            {"text":"poco","start":22,"end":26,"lemmaId":511276779}
          ],
          "grammarIds": [5,16]
        },
        {
          "it": "«E allora devo farle la domanda importante. Toro o Juve?»",
          "en": "\"Well then, I have to ask you the important question. Toro or Juve?\"",
          "tokens": [
            {"text":"E","start":1,"end":2,"lemmaId":1646006819},
            {"text":"allora","start":3,"end":9,"lemmaId":1636569757},
            {"text":"devo","start":10,"end":14,"lemmaId":960567925},
