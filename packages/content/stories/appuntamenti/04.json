            {"text":"Juve","start":51,"end":55,"lemmaId":null,"isName":true}
          ],
          "grammarIds": [1,2,7,14,26]
        },
        {
          "it": "«Veramente non seguo il calcio.»",
          "en": "\"Actually, I don't follow football.\"",
          "tokens": [
            {"text":"Veramente","start":1,"end":10,"lemmaId":1731562601},
            {"text":"non","start":11,"end":14,"lemmaId":310745945},
            {"text":"seguo","start":15,"end":20,"lemmaId":854307150},
            {"text":"il","start":21,"end":23,"lemmaId":572321737},
            {"text":"calcio","start":24,"end":30,"lemmaId":334230620}
          ],
          "grammarIds": [1,2,9,12]
        },
        {
