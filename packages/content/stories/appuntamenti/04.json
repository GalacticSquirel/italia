            {"text":"lavora","start":7,"end":13,"lemmaId":2081886162},
            {"text":"Enzo","start":15,"end":19,"lemmaId":null,"isName":true},
            {"text":"parla","start":20,"end":25,"lemmaId":146687855},
            {"text":"di","start":26,"end":28,"lemmaId":1629507913},
            {"text":"tutto","start":29,"end":34,"lemmaId":597221166},
            {"text":"della","start":36,"end":41,"lemmaId":1629507913,"partIds":[572321737]},
