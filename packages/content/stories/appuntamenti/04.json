          "en": "Enzo stops. \"You don't follow football? In Turin?\"",
          "tokens": [
            {"text":"Enzo","start":0,"end":4,"lemmaId":null,"isName":true},
            {"text":"si","start":5,"end":7,"lemmaId":813176480},
            {"text":"ferma","start":8,"end":13,"lemmaId":646681706},
            {"text":"Non","start":16,"end":19,"lemmaId":310745945},
            {"text":"segue","start":20,"end":25,"lemmaId":854307150},
