          "tokens": [
            {"text":"Allora","start":1,"end":7,"lemmaId":1636569757},
            {"text":"chiede","start":10,"end":16,"lemmaId":1009137211},
            {"text":"Enzo","start":17,"end":21,"lemmaId":null,"isName":true}
          ],
          "grammarIds": [12]
        },
        {
          "it": "«Aveva ragione lei. Quanto le devo?»",
          "en": "\"You were right. How much do I owe you?\"",
          "tokens": [
            {"text":"Aveva","start":1,"end":6,"lemmaId":1570010189},
            {"text":"ragione","start":7,"end":14,"lemmaId":1836903616},
            {"text":"lei","start":15,"end":18,"lemmaId":492290760},
            {"text":"Quanto","start":20,"end":26,"lemmaId":1433585188},
            {"text":"le","start":27,"end":29,"lemmaId":1934059893},
            {"text":"devo","start":30,"end":34,"lemmaId":960567925}
          ],
          "grammarIds": [1,4,10,14,26,29]
        },
        {
