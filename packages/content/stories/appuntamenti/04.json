          "en": "The next day, at the meeting, a girl from the office looks at his hair.",
          "tokens": [
            {"text":"Il","start":0,"end":2,"lemmaId":572321737},
            {"text":"giorno","start":3,"end":9,"lemmaId":1778842393},
            {"text":"dopo","start":10,"end":14,"lemmaId":397621412},
