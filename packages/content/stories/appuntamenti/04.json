            {"text":"e","start":15,"end":16,"lemmaId":1646006819},
            {"text":"dietro","start":17,"end":23,"lemmaId":1886372317},
            {"text":"Sopra","start":25,"end":30,"lemmaId":603640921},
            {"text":"non","start":31,"end":34,"lemmaId":310745945},
            {"text":"troppo","start":35,"end":41,"lemmaId":1275340524}
          ],
          "grammarIds": [1,9,17]
        },
        {
          "it": "«Non troppo», ripete Enzo, e comincia a tagliare.",
