            {"text":"partita","start":66,"end":73,"lemmaId":1773089436}
          ],
          "grammarIds": [1,3,5,9,11,12,17]
        },
        {
          "it": "Può cominciare oggi.»",
          "en": "You can start today.\"",
          "tokens": [
            {"text":"Può","start":0,"end":3,"lemmaId":1082530027},
            {"text":"cominciare","start":4,"end":14,"lemmaId":1835837434},
            {"text":"oggi","start":15,"end":19,"lemmaId":1584344846}
          ],
          "grammarIds": [14]
        }
      ]
    },
    {
      "sentences": [
        {
          "it": "Mentre lavora, Enzo parla di tutto: della squadra, del freddo, dei clienti.",
          "en": "As he works, Enzo talks about everything: the team, the cold, his customers.",
