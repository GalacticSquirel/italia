            {"text":"me","start":21,"end":23,"lemmaId":1241965086},
            {"text":"Faccio","start":25,"end":31,"lemmaId":1788811798},
            {"text":"questo","start":32,"end":38,"lemmaId":1755513727},
            {"text":"lavoro","start":39,"end":45,"lemmaId":1886762730},
            {"text":"da","start":46,"end":48,"lemmaId":663456737},
            {"text":"una","start":49,"end":52,"lemmaId":736601827},
            {"text":"vita","start":53,"end":57,"lemmaId":1937347093}
          ],
          "grammarIds": [1,3,4,13,14,16,18,24]
        }
      ]
    },
    {
      "sentences": [
        {
          "it": "Alla fine Davide si guarda bene.",
