            {"text":"alla","start":35,"end":39,"lemmaId":714887343,"partIds":[572321737]},
            {"text":"porta","start":40,"end":45,"lemmaId":1680963123}
          ],
          "grammarIds": [1,11,17,26]
        },
        {
          "it": "«Tra tre giorni c'è la partita. La guardiamo al bar qui davanti. Viene anche lei?»",
          "en": "\"There's a match in three days. We're watching it at the bar opposite. Are you coming too?\"",
          "tokens": [
            {"text":"Tra","start":1,"end":4,"lemmaId":448876689},
            {"text":"tre","start":5,"end":8,"lemmaId":307219138},
            {"text":"giorni","start":9,"end":15,"lemmaId":1778842393},
            {"text":"c'","start":16,"end":18,"lemmaId":1407154832},
            {"text":"è","start":18,"end":19,"lemmaId":1898857869},
            {"text":"la","start":20,"end":22,"lemmaId":572321737},
            {"text":"partita","start":23,"end":30,"lemmaId":1773089436},
            {"text":"La","start":32,"end":34,"lemmaId":572321737},
            {"text":"guardiamo","start":35,"end":44,"lemmaId":550261201},
            {"text":"al","start":45,"end":47,"lemmaId":714887343,"partIds":[572321737]},
            {"text":"bar","start":48,"end":51,"lemmaId":927998710},
            {"text":"qui","start":52,"end":55,"lemmaId":1744058167},
            {"text":"davanti","start":56,"end":63,"lemmaId":2101884929},
            {"text":"Viene","start":65,"end":70,"lemmaId":1569449289},
            {"text":"anche","start":71,"end":76,"lemmaId":1558928757},
            {"text":"lei","start":77,"end":80,"lemmaId":492290760}
          ],
          "grammarIds": [1,2,4,5,8,11,13,16,17]
        },
        {
          "it": "«Ma io di queste cose non capisco niente.»",
          "en": "\"But I don't know the first thing about all that.\"",
          "tokens": [
