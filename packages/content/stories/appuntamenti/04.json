    {
      "sentences": [
        {
          "it": "«Buongiorno. Allora, come li tagliamo?»",
          "en": "\"Good morning. So, how are we cutting it?\"",
          "tokens": [
            {"text":"Buongiorno","start":1,"end":11,"lemmaId":1890158688},
            {"text":"Allora","start":13,"end":19,"lemmaId":1636569757},
            {"text":"come","start":21,"end":25,"lemmaId":136575964},
            {"text":"li","start":26,"end":28,"lemmaId":1677222401},
            {"text":"tagliamo","start":29,"end":37,"lemmaId":394170735}
          ],
          "grammarIds": [1,10,11,26]
        },
        {
          "it": "«Corti ai lati e dietro. Sopra non troppo.»",
          "en": "\"Short at the sides and back. Not too much off the top.\"",
          "tokens": [
            {"text":"Corti","start":1,"end":6,"lemmaId":1016997911},
            {"text":"ai","start":7,"end":9,"lemmaId":714887343,"partIds":[572321737]},
