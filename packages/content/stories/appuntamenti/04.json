            {"text":"bene","start":51,"end":55,"lemmaId":2005558240},
            {"text":"Davvero","start":57,"end":64,"lemmaId":1493064783},
            {"text":"bene","start":65,"end":69,"lemmaId":2005558240}
          ],
          "grammarIds": [1,6,9,13,21,28]
        },
