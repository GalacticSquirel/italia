          "it": "«Non importa. Qui dentro siamo tutti del Toro, e non perdiamo una partita.",
          "en": "\"Never mind. In here we're all Toro fans, and we never miss a match.",
          "tokens": [
            {"text":"Non","start":1,"end":4,"lemmaId":310745945},
            {"text":"importa","start":5,"end":12,"lemmaId":354437479},
            {"text":"Qui","start":14,"end":17,"lemmaId":1744058167},
            {"text":"dentro","start":18,"end":24,"lemmaId":758202362},
            {"text":"siamo","start":25,"end":30,"lemmaId":1898857869},
            {"text":"tutti","start":31,"end":36,"lemmaId":597221166},
            {"text":"del","start":37,"end":40,"lemmaId":1629507913,"partIds":[572321737]},
            {"text":"Toro","start":41,"end":45,"lemmaId":null,"isName":true},
            {"text":"e","start":47,"end":48,"lemmaId":1646006819},
