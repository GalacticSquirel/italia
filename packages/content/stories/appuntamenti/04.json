            {"text":"capelli","start":25,"end":32,"lemmaId":94140733},
            {"text":"Troppi","start":34,"end":40,"lemmaId":1275340524},
            {"text":"capelli","start":41,"end":48,"lemmaId":94140733}
          ],
          "grammarIds": [1,7,12]
        },
        {
          "it": "«Enzo... avevo detto non troppo.»",
          "en": "\"Enzo... I did say not too much.\"",
          "tokens": [
            {"text":"Enzo","start":1,"end":5,"lemmaId":null,"isName":true},
