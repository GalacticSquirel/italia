            {"text":"fa","start":54,"end":56,"lemmaId":1788811798},
            {"text":"molto","start":57,"end":62,"lemmaId":583564871},
            {"text":"freddo","start":63,"end":69,"lemmaId":1730485032}
          ],
          "grammarIds": [1,2,7,9,11,12,13,16]
        },
        {
          "it": "«Da quanto tempo?»",
          "en": "\"Since when?\"",
          "tokens": [
