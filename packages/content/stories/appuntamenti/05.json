            {"text":"quanto","start":4,"end":10,"lemmaId":1433585188},
            {"text":"tempo","start":11,"end":16,"lemmaId":1963689628}
          ],
          "grammarIds": [1,10,16]
        },
        {
          "it": "«Da stamattina, credo. Ieri sera funzionava tutto.»",
          "en": "\"Since this morning, I think. Yesterday evening everything was working.\"",
