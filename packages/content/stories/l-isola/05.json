            {"text":"adesso","start":52,"end":58,"lemmaId":310613447},
            {"text":"trova","start":60,"end":65,"lemmaId":1443899561},
            {"text":"il","start":66,"end":68,"lemmaId":572321737},
            {"text":"modo","start":69,"end":73,"lemmaId":297146920},
            {"text":"di","start":74,"end":76,"lemmaId":1629507913},
            {"text":"fermarci","start":77,"end":85,"lemmaId":646681706,"partIds":[1407154832]}
          ],
          "grammarIds": [1,2,6,7,11,12,16,26]
        },
        {
          "it": "E io accompagno i malati di notte, senza licenza: basta questo per perdere l'autorizzazione.",
          "en": "And I carry the sick at night, without a licence: that alone is enough to lose the authorisation.",
          "tokens": [
            {"text":"E","start":0,"end":1,"lemmaId":1646006819},
            {"text":"io","start":2,"end":4,"lemmaId":1566153184},
