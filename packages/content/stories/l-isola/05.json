          ],
          "grammarIds": [1,2,11,13,16,26,36,57]
        },
        {
          "it": "Ogni famiglia ha messo quello che poteva, e abbiamo creato un'associazione degli abitanti.",
          "en": "Every family has put in what it could, and we've set up a residents' association.",
          "tokens": [
            {"text":"Ogni","start":0,"end":4,"lemmaId":1164351947},
            {"text":"famiglia","start":5,"end":13,"lemmaId":4898577},
            {"text":"ha","start":14,"end":16,"lemmaId":1570010189},
