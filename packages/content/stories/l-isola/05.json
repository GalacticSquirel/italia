            {"text":"Irene","start":9,"end":14,"lemmaId":null,"isName":true}
          ],
          "grammarIds": [12]
        },
        {
          "it": "«Lei è la giornalista di Milano. Mi hanno detto che fa molte domande.»",
          "en": "\"You're the journalist from Milan. They tell me you ask a lot of questions.\"",
          "tokens": [
            {"text":"Lei","start":1,"end":4,"lemmaId":492290760},
