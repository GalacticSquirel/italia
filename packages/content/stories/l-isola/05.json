          "grammarIds": [1,3,12,24]
        }
      ]
    },
    {
      "sentences": [
        {
          "it": "Turi la guarda a lungo, poi apre la porta del deposito.",
          "en": "Turi looks at her for a long time, then opens the door of the boathouse.",
          "tokens": [
            {"text":"Turi","start":0,"end":4,"lemmaId":null,"isName":true},
            {"text":"la","start":5,"end":7,"lemmaId":1460621433},
