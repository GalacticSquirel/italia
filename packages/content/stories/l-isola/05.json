            {"text":"montato","start":73,"end":80,"lemmaId":1822131580}
          ],
          "grammarIds": [1,2,5,11,15,16]
        },
        {
          "it": "Su un lato qualcuno ha scritto il nome a mano: \"Speranza\".",
          "en": "On one side someone has written the name by hand: \"Speranza\".",
          "tokens": [
