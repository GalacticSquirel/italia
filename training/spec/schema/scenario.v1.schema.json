{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://italia.app/schemas/tutor/scenario.v1.schema.json",
  "x-spec-version": "1.1.0",
  "$defs": {
    "Level": {
      "description": "CEFR levels the tutor supports, A1 through C2 (fluency).",
      "enum": [
        "A1",
        "A2",
        "B1",
        "B2",
        "C1",
        "C2"
      ],
      "type": "string"
    },
    "ScenarioGoal": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "description"
      ],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "An everyday task the learner role-plays with the tutor (see `scenarios/*.yaml`).",
  "properties": {
    "id": {
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "type": "string"
    },
    "titleEn": {
      "minLength": 1,
      "type": "string"
    },
    "levels": {
      "items": {
        "$ref": "#/$defs/Level"
      },
      "minItems": 1,
      "type": "array"
    },
    "setting": {
      "minLength": 1,
      "type": "string"
    },
    "tutorRole": {
      "minLength": 1,
      "type": "string"
    },
    "learnerRole": {
      "minLength": 1,
      "type": "string"
    },
    "formality": {
      "enum": [
        "formal",
        "informal"
      ],
      "type": "string"
    },
    "goals": {
      "items": {
        "$ref": "#/$defs/ScenarioGoal"
      },
      "maxItems": 6,
      "minItems": 2,
      "type": "array"
    },
    "keyVocab": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 5,
      "type": "array"
    },
    "grammarFocus": {
      "items": {
        "pattern": "^[a-z0-9][a-z0-9-]*$",
        "type": "string"
      },
      "type": "array"
    },
    "opening": {
      "minLength": 1,
      "type": "string"
    },
    "tags": {
      "items": {
        "pattern": "^[a-z0-9][a-z0-9-]*$",
        "type": "string"
      },
      "type": "array"
    },
    "split": {
      "default": "train",
      "enum": [
        "train",
        "eval"
      ],
      "type": "string"
    }
  },
  "required": [
    "id",
    "title",
    "titleEn",
    "levels",
    "setting",
    "tutorRole",
    "learnerRole",
    "formality",
    "goals",
    "keyVocab",
    "opening"
  ],
  "type": "object"
}
