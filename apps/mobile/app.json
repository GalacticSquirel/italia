{
  "expo": {
    "name": "Italia",
    "slug": "italia",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "italia",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.italia.app",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.italia.app"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-sharing",
      "expo-asset",
      [
        "expo-audio",
        {
          "microphonePermission": "Italia uses the microphone to hear you speak Italian in speaking drills and shadowing. Your voice is processed on this phone and never uploaded.",
          "recordAudioAndroid": true,
          "enableBackgroundPlayback": true
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Italia uses the microphone to hear you speak Italian in speaking drills and shadowing. Your voice is processed on this phone and never uploaded.",
          "speechRecognitionPermission": "Italia can use your phone's own speech recognition, on this phone, to check your spoken Italian when the downloaded recognizer is not installed.",
          "androidSpeechServicePackages": [
            "com.google.android.as",
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      "onnxruntime-react-native",
      "./plugins/withOnnxRuntimeCoexistence",
      [
        "llama.rn",
        {
          "enableEntitlements": true,
          "entitlementsProfile": ["development", "preview", "production"],
          "enableOpenCLAndHexagon": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
